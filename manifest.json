{
  "manifest_version": 3,
  "name": "Clothwork — Clothing Manager",
  "version": "0.7.0",
  "description": "A friendly classic clothing workspace: select, preview, copy, and track edits with official Roblox Creator Hub links.",
  "action": {
    "default_title": "Open Clothwork editor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://itemconfiguration.roblox.com/*",
    "https://groups.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://create.roblox.com/dashboard/*"
      ],
      "js": [
        "widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "widget.css",
        "icon48.png"
      ],
      "matches": [
        "https://create.roblox.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
